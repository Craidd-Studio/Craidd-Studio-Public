{
  "name": "craidd-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:linked-startup": "node --test tests/linkedStartup.test.mjs tests/windowAttention.test.mjs tests/duplicateWindowPolicy.test.mjs",
    "test:build-output": "node --test tests/buildDiagnostics.test.mjs tests/outputPresentation.test.mjs",
    "test:save-restart": "node --test tests/saveRestartPolicy.test.mjs",
    "test:native-debug": "node --test tests/nativeDebug.test.mjs tests/nativeStepCapability.test.mjs",
    "test:shortcuts": "node --test tests/shortcuts.test.mjs tests/pathActions.test.mjs",
    "test:exit": "node --test tests/exitBlockers.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:docs": "node --test tests/markdownDocs.test.mjs",
    "test:perf-presentation": "node --test tests/perfPresentation.test.mjs",
    "test:ui:profiler-analysis": "CRAIDD_TEST_PROFILER_ANALYSIS=1 node --test tests/ui/profiler-analysis.test.mjs",
    "test:profiling": "node --test tests/profiling.test.mjs",
    "test:metrics": "cargo test --offline --manifest-path workspaces/profiling-metrics/Cargo.toml",
    "test:ui:metrics": "CRAIDD_TEST_METRICS=1 node --test tests/ui/metric-import.test.mjs",
    "test:ui:metric-ux": "CRAIDD_TEST_METRICS=1 node --test tests/ui/metric-ux.test.mjs",
    "test:ui:build": "tauri build --debug --no-bundle",
    "test:ui": "node --test --test-concurrency=1 tests/ui/*.test.mjs",
    "test:ui:profiling": "CRAIDD_TEST_UNITY=1 node --test --test-concurrency=1 tests/ui/profiler-icons.test.mjs tests/ui/unity-profiling.test.mjs tests/ui/unity-scopes.test.mjs tests/ui/unity-recovery.test.mjs tests/ui/unity-overlay.test.mjs tests/ui/unity-review-regressions.test.mjs",
    "test:ui:profiling:long": "CRAIDD_TEST_LONG=1 npm run test:ui:profiling",
    "test:profiler-workspace": "node tests/profilerWorkspace.test.mjs",
    "test:ui:profiler-workspace": "node tests/ui/profiler-workspace.test.mjs",
    "test:ui:metric-release": "CRAIDD_TEST_METRIC_RELEASE=1 node --test --test-concurrency=1 tests/ui/metric-release-acceptance.test.mjs",
    "test:ui:metric-editor": "CRAIDD_TEST_METRIC_EDITOR=1 node --test tests/ui/metric-editor-quality.test.mjs",
    "test:ui:perf-leaf": "CRAIDD_TEST_PERF_LEAF=1 node --test tests/ui/perf-leaf-coverage.test.mjs",
    "test:ui:perf-symbols": "CRAIDD_TEST_PERF_SYMBOLS=1 node --test tests/ui/perf-symbol-locations.test.mjs",
    "test:project-wizard": "node tests/projectWizard.test.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@types/hast": "^3.0.5"
  }
}
